{
  "name": "boilerplate-vite",
  "description": "A TypeScript starter for Vite + React that includes all you need to build amazing projects",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "keywords": [
    "vite",
    "react",
    "boilerplate",
    "typescript",
    "tailwindcss",
    "eslint",
    "prettier"
  ],
  "engines": {
    "node": "^22.22.1 || >=24.10.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "yarn type-check && vite build",
    "preview": "vite preview",
    "serve": "vite preview",
    "type-check": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "yarn type-check && yarn lint && yarn format:check",
    "commit": "cz",
    "release": "semantic-release",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@ialexanderbrito/eslint-config": "3.0.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.4",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "10.15.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "semantic-release": "25.0.9",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.4.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
